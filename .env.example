# Copy to .env.local and fill in ONE of the following.
# .env.local is git-ignored. Never commit real values.
#
# Needed only to reach maangchi.com and justonecookbook.com, which return 403
# to datacenter IPs (DECISIONS §6). koreanbapsang.com and thewoksoflife.com
# crawl fine without any of this.

# --- Option A: Apify residential proxy -------------------------------------
# IMPORTANT: this is the *proxy password*, not the API token. They are
# different strings. Apify Console → Proxy → HTTP settings → password.
APIFY_PROXY_PASSWORD=

# Optional: comma-separated Apify proxy options appended to the username.
# Default is residential + US exit nodes.
APIFY_PROXY_GROUPS=groups-RESIDENTIAL,country-US

# --- Option B: Apify API token ---------------------------------------------
# Only needed if we later run Apify *actors* (e.g. for TikTok comments, which
# yt-dlp cannot extract — SOCIAL-INGEST §3). Not used for proxying.
APIFY_TOKEN=

# --- Option C: ScraperAPI --------------------------------------------------
# The vendor already used by ~/booktrends (fetch.py reads SCRAPERAPI_KEY).
SCRAPERAPI_KEY=
