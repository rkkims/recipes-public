node_modules/
.env
.env.local
# Server config, not source. Holds INSECURE_COOKIES today and the Weee
# affiliate tag once that account exists — the second is a credential.
app/.env.production
data/raw/
data/reports/
*.log
storage/
apify_storage/
crawl.log
data/qc/*

# …EXCEPT the drafted hierarchy answers. Everything else under data/qc/ is
# derived and regenerates on demand; these do not — an LLM draft is not
# reproducible byte-for-byte, and the three CSVs are built FROM them. Same
# argument as data/decisions/ and data/curation/: judgement is the part that
# does not come back if it is lost.
!data/qc/llm-answers/

# Same argument, same two passes that draft rather than derive: the answers to
# `npm run classify` and `npm run converge`. The batches that produced them
# (`*-ask/`) stay ignored — those DO regenerate from the script and the corpus.
!data/qc/classify-answers/
!data/qc/converge-answers/

# data/decisions/ is TRACKED — it is reviewed human judgement and the least
# reconstructible thing here, the same argument INGREDIENT-SPEC §7 makes for
# identity.csv. Hand-made backups are not: git is the backup now.
data/decisions/*.bak

# Phase A app
app/node_modules/
app/.next/
# And the same thing at the ROOT, which is not a build anyone asked for.
#
# `next.config.mjs` sets `distDir` relative to `app/`, so every real build lands
# in `app/.next*` and this directory only appears when a `next` command is run
# from the repo root by mistake. One did, and `e92217a` — a curation commit —
# swept 22 files of turbopack cache in with it. Nothing reads them, every build
# rewrites them, and they showed up dirty in every `git status` afterwards.
/.next/
data/app/
# Snapshots of the one file that cannot be regenerated — taken on every deploy,
# fourteen days kept. Same reason `data/app/` is ignored: it is a user's pantry,
# not source.
data/backup/
# The behavioural record — BEHAVIOR-SPEC §2. Written by the running app, one
# JSONL line per event, and it carries `household` ids on pantry and cook rows.
# Same reason as `data/app/`: it is live user data, not source, and a checkout
# must never clobber it — nor should a `git add .` commit somebody's kitchen.
data/events/
data/enriched/
# The creator side's runtime half — claims, added recipes, self-registrations,
# removals. Written by the running app (and the removal script), read fresh per
# request, living beside the pipeline's CSVs which ARE source and stay tracked.
# Same reason as `data/app/`: a checkout must never clobber live state.
data/creators/claims.json
data/creators/recipes.json
data/creators/self.json
data/creators/removals.json

# data/curation/ is TRACKED — same argument as data/decisions/: it is human
# judgement, one recipe at a time, and nothing regenerates it.

# Weee! catalogue — derived caches, regenerable by re-running the pipeline.
# shelves.csv is NOT here: it is a reviewed file, the record of which shelves
# hold ingredients (WEEE-SPEC §9 step 1).
data/weee/parsed.csv
data/weee/sitemap-titles.csv
data/weee/offline/
data/weee/offline.tar.gz

# TypeScript incremental build state — a local artifact, rewritten on every
# build and meaningless in a diff.
app/tsconfig.tsbuildinfo
*.tsbuildinfo
# A second build output, so a dev build never overwrites the one being served.
app/.next-dev/
# A third, for checking that a change really builds without touching either of
# the other two — the reviewer's session on :5173 reads `.next` for hours.
app/.next-verify/
# And the one the systemd unit actually serves. Production reads this; the
# curation session on :5173 reads `.next`; a deploy must never touch that.
app/.next-prod/
# The staging build and the one it replaced. `deploy.sh` builds into staging and
# only promotes it on success, keeping the previous one just long enough to roll
# back to — see the note at the top of that script.
app/.next-staging/
app/.next-prev/
# And the one a slice's own check builds into, so proving that the SERVER build
# still succeeds never costs the reviewer the session they are sitting on.
app/.next-slice/
# Generated by Next, and it now flips between the two build outputs on every
# build (see app/next.config.mjs distDir) — pure churn in every diff.
app/next-env.d.ts

# Capacitor: dependencies and CocoaPods output are generated on the build machine.
mobile/node_modules/
mobile/ios/App/Pods/
mobile/ios/App/Podfile.lock
mobile/ios/App/App/public/
mobile/ios/capacitor-cordova-ios-plugins/
app/public/cached-images/
data/images/user/
static-data/
app/public/static-data/
# The static export — STATIC-SPEC §5. `app/.next-static` is where Next puts it
# (Turbopack refuses a `distDir` outside the project) and `static-out/` is where
# `build-static` moves it for `wrangler deploy`. Both are regenerated from the
# curated tables in one command, so neither belongs in a diff.
app/.next-static/
static-out/

# Agent worktrees — transient copies of this repo, never committed.
.claude/worktrees/

# Public repo: the corpus, creator records, curation, QC answers, retailer
# catalogue and cached images live in the private data repo, not here.
data/ontology/recipe-lines.json
data/ontology/recipe-index.json
data/ontology/llm-lines.json
data/ontology/classify.json
data/ontology/resolutions.json
data/ontology/main-proposals.json
data/ontology/dead-images.json
data/creators/
data/curation/
data/qc/
data/weee/
data/images/
app/public/cached-images/
